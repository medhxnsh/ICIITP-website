# ── JWT secret ────────────────────────────────────────────────────────────────
JWT_SECRET=a2dbb208f3484d5d866defa4f60583688bcd45ee384a7164f89b70f81c433829

# ── Admin account (seeded on first run) ───────────────────────────────────────
ADMIN_EMAIL=admin@iciitp.ac.in
ADMIN_PASSWORD=R7BVhpt2p542pIwI1edb

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://iciitp.ac.in

# ── Internal service URLs ─────────────────────────────────────────────────────
# Local dev: frontend talks to backend on localhost.
# Docker: docker-compose.yml overrides this to http://backend:8080/api/v1
API_URL=http://localhost:8080/api/v1

# ── SMTP (email notifications + OTP) ─────────────────────────────────────────
# For Gmail testing: use smtp.gmail.com:587 with an App Password
# (Google Account → Security → 2-Step Verification → App Passwords)
# For institutional: smtp.iitp.ac.in:587 once credentials are available.
# Leave SMTP_USER blank to disable email entirely.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fakeidforusacc@gmail.com
SMTP_PASS="agxs heow hmnv vtjd"

# ── Recovery & notification email ─────────────────────────────────────────────
# OTPs for password reset go to RECOVERY_EMAIL.
# Form submission notifications go to NOTIFY_EMAIL.
RECOVERY_EMAIL=fakeidforusacc@gmail.com
NOTIFY_EMAIL=fakeidforusacc@gmail.com

# ── Hibernate schema mode ─────────────────────────────────────────────────────
# validate = production safe: refuses to start if schema doesn't match entities.
# update  = dev only: auto-adds missing columns (never use on live server).
# When adding a new entity field: run ALTER TABLE manually, then restart.
HIBERNATE_DDL_AUTO=validate

# ── Emergency admin reset ─────────────────────────────────────────────────────
# Set to true to force-update admin password on next backend restart.
# Must set back to false after recovering access.
ADMIN_FORCE_RESET=false
