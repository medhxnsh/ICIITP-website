# ─────────────────────────────────────────────────────────────────────────────
# IC IITP — Central environment configuration
# Copy this file to config/.env and fill in all values before running Docker.
# This is the single source of truth for all services (db, backend, frontend).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=iciitp
DB_USER=iciitp
DB_PASSWORD=change-this-to-a-strong-password

# ── JWT secret ────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -hex 32
# Must be identical across backend and frontend containers.
JWT_SECRET=change-this-to-a-random-secret-minimum-32-chars

# ── Admin account (seeded on first run) ───────────────────────────────────────
ADMIN_EMAIL=admin@iciitp.ac.in
ADMIN_PASSWORD=change-this-to-a-strong-password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL, no trailing slash. Used by the backend to allow cross-origin requests.
CORS_ORIGINS=https://iciitp.ac.in

# ── Internal service URLs ─────────────────────────────────────────────────────
# Keep as localhost for local dev. Docker overrides this to http://backend:8080/api/v1
# via docker-compose.yml's environment block — do not change here for Docker.
API_URL=http://localhost:8080/api/v1

# ── SMTP (email notifications + password reset OTP) ───────────────────────────
# Leave SMTP_USER blank to disable email entirely (OTPs won't be sent, but flow still works).
#
# ┌─ TESTING (Gmail App Password) ──────────────────────────────────────────┐
# │  SMTP_HOST=smtp.gmail.com                                               │
# │  SMTP_PORT=587                                                          │
# │  SMTP_USER=yourname@gmail.com                                           │
# │  SMTP_PASS="xxxx xxxx xxxx xxxx"   ← quote it, spaces break shell      │
# │  (Google Account → Security → 2-Step Verification → App Passwords)     │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─ PRODUCTION (IIT Patna institutional SMTP) ─────────────────────────────┐
# │  SMTP_HOST=smtp.iitp.ac.in                                              │
# │  SMTP_PORT=587                                                          │
# │  SMTP_USER=ic@iitp.ac.in          ← get credentials from IT cell       │
# │  SMTP_PASS=<institutional password>                                     │
# └─────────────────────────────────────────────────────────────────────────┘
SMTP_HOST=smtp.iitp.ac.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Recovery & notification emails ────────────────────────────────────────────
# RECOVERY_EMAIL: where password reset OTPs are sent.
# NOTIFY_EMAIL: where form submission alerts (apply/contact/feedback) are sent.
RECOVERY_EMAIL=admin@iciitp.ac.in
NOTIFY_EMAIL=admin@iciitp.ac.in

# ── Emergency admin reset ──────────────────────────────────────────────────────
# Set to true to force-update admin password on next backend restart.
# Resets to value of ADMIN_PASSWORD above. Set back to false after recovery.
ADMIN_FORCE_RESET=false
